CREATE TABLE AuditItem (
    auditItemId INTEGER PRIMARY KEY NOT NULL,
    auditItemTitle TEXT,
    image TEXT,
    formUpdatedTime TEXT
);

insertAuditItem:
INSERT OR REPLACE INTO AuditItem(auditItemId, auditItemTitle, image, formUpdatedTime)
VALUES (?, ?, ?, ?);

getAllAuditItems:
SELECT * FROM AuditItem;

clearAllAuditItems:
DELETE FROM AuditItem;

getLatestAuditItemUpdatedTime:
SELECT formUpdatedTime FROM AuditItem ORDER BY formUpdatedTime DESC LIMIT 1;

CREATE TABLE InspectionContentCache (
    type INTEGER PRIMARY KEY NOT NULL,
    version TEXT,
    questionsJson TEXT NOT NULL,
    updatedTime TEXT
);

insertInspectionContentCache:
INSERT OR REPLACE INTO InspectionContentCache(type, version, questionsJson, updatedTime)
VALUES (?, ?, ?, ?);

getInspectionContentCacheByType:
SELECT * FROM InspectionContentCache WHERE type = ?;

getAllInspectionContentCaches:
SELECT * FROM InspectionContentCache;

clearAllInspectionContentCaches:
DELETE FROM InspectionContentCache;

getLatestInspectionContentUpdatedTime:
SELECT updatedTime FROM InspectionContentCache ORDER BY updatedTime DESC LIMIT 1;

CREATE TABLE InspectionDraft (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    facilitiesId INTEGER,
    projectJson TEXT,
    inspectionTypeId INTEGER NOT NULL,
    inspectionTypeName TEXT,
    inspectionTypeUpdatedTime TEXT,
    inspectionContentVersion TEXT,
    location TEXT,
    inspectionDateMillis INTEGER,
    description TEXT,
    notes TEXT,
    questionsJson TEXT,
    answersJson TEXT,
    imagesJson TEXT,
    createdAt TEXT,
    userId INTEGER NOT NULL
);

insertInspectionDraft:
INSERT OR REPLACE INTO InspectionDraft(
