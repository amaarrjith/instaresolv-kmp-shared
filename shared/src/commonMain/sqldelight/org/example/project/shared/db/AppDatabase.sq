CREATE TABLE PreTaskContent (
    id INTEGER PRIMARY KEY NOT NULL,
    title TEXT NOT NULL,
    updatedTime TEXT NOT NULL,
    sortOrder INTEGER NOT NULL
);

CREATE TABLE PreTaskQuestion (
    id INTEGER PRIMARY KEY NOT NULL,
    contentId INTEGER NOT NULL,
    title TEXT NOT NULL,
    imageUrl TEXT NOT NULL,
    updatedTime TEXT NOT NULL
);

insertPreTaskContent:
INSERT OR REPLACE INTO PreTaskContent(id, title, updatedTime, sortOrder)
VALUES (?, ?, ?, ?);

getAllPreTaskContents:
SELECT * FROM PreTaskContent ORDER BY sortOrder ASC;

deletePreTaskContent:
DELETE FROM PreTaskContent WHERE id = ?;

clearAllPreTaskContents:
DELETE FROM PreTaskContent;

getLatestContentUpdatedTime:
SELECT updatedTime FROM PreTaskContent ORDER BY updatedTime DESC LIMIT 1;

insertPreTaskQuestion:
INSERT OR REPLACE INTO PreTaskQuestion(id, contentId, title, imageUrl, updatedTime)
VALUES (?, ?, ?, ?, ?);

getAllPreTaskQuestions:
SELECT * FROM PreTaskQuestion;

deletePreTaskQuestion:
DELETE FROM PreTaskQuestion WHERE id = ?;

clearAllPreTaskQuestions:
DELETE FROM PreTaskQuestion;

getLatestQuestionUpdatedTime:
SELECT updatedTime FROM PreTaskQuestion ORDER BY updatedTime DESC LIMIT 1;

