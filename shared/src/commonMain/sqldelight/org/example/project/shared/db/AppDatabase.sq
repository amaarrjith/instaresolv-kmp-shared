import kotlin.String;
import kotlin.collections.List;

CREATE TABLE ObservationDraft (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    location TEXT NOT NULL,
    description TEXT NOT NULL,
    groupSpecified INTEGER NOT NULL,
    groupJson TEXT,
    reportedBy TEXT NOT NULL,
    customResponsiblePersonName TEXT NOT NULL,
    responsiblePersonId INTEGER NOT NULL,
    responsiblePersonName TEXT NOT NULL,
    responsiblePersonEmail TEXT NOT NULL,
    audioLink TEXT,
    imageDescriptionsJson TEXT AS List<String> NOT NULL,
    notificationToJson TEXT AS List<String> NOT NULL,
    createdAt TEXT,
    userId INTEGER NOT NULL
);

insertDraft:
INSERT INTO ObservationDraft(title, location, description, groupSpecified, groupJson, reportedBy, customResponsiblePersonName, responsiblePersonId, responsiblePersonName, responsiblePersonEmail, audioLink, imageDescriptionsJson, notificationToJson, createdAt, userId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDraft:
UPDATE ObservationDraft
SET
    title = ?,
    location = ?,
    description = ?,
    groupSpecified = ?,
    groupJson = ?,
    reportedBy = ?,
    customResponsiblePersonName = ?,
    responsiblePersonId = ?,
    responsiblePersonName = ?,
    responsiblePersonEmail = ?,
    audioLink = ?,
    imageDescriptionsJson = ?,
    notificationToJson = ?,
    createdAt = ?,
    userId = ?
WHERE id = ?;

getAllDrafts:
SELECT * FROM ObservationDraft;

getDraftsByUserId:
SELECT * FROM ObservationDraft WHERE userId = ? ORDER BY id DESC;

deleteDraft:
DELETE FROM ObservationDraft WHERE id = ?;
