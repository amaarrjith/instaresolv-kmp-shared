import kotlin.String;
import kotlin.collections.List;

CREATE TABLE ObservationDraft (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    location TEXT NOT NULL,
    description TEXT NOT NULL,
    groupSpecified INTEGER NOT NULL,
    groupJson TEXT,
    reportedBy TEXT NOT NULL,
    customResponsiblePersonName TEXT NOT NULL,
    responsiblePersonId INTEGER NOT NULL,
    responsiblePersonName TEXT NOT NULL,
    responsiblePersonEmail TEXT NOT NULL,
    audioLink TEXT,
    imageDescriptionsJson TEXT AS List<String> NOT NULL,
    notificationToJson TEXT AS List<String> NOT NULL,
    createdAt TEXT,
    userId INTEGER NOT NULL
);

insertDraft:
INSERT INTO ObservationDraft(title, location, description, groupSpecified, groupJson, reportedBy, customResponsiblePersonName, responsiblePersonId, responsiblePersonName, responsiblePersonEmail, audioLink, imageDescriptionsJson, notificationToJson, createdAt, userId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDraft:
UPDATE ObservationDraft
SET
    title = ?,
    location = ?,
    description = ?,
    groupSpecified = ?,
    groupJson = ?,
    reportedBy = ?,
    customResponsiblePersonName = ?,
    responsiblePersonId = ?,
    responsiblePersonName = ?,
    responsiblePersonEmail = ?,
    audioLink = ?,
    imageDescriptionsJson = ?,
    notificationToJson = ?,
    createdAt = ?,
    userId = ?
WHERE id = ?;

getAllDrafts:
SELECT * FROM ObservationDraft;

getDraftsByUserId:
SELECT * FROM ObservationDraft WHERE userId = ? ORDER BY id DESC;

deleteDraft:
DELETE FROM ObservationDraft WHERE id = ?;

CREATE TABLE ViolationDraft (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    facilitiesId TEXT,
    facilityJson TEXT,
    employeeName TEXT NOT NULL,
    employeeId TEXT NOT NULL,
    violationDate TEXT NOT NULL,
    violationDateMillis INTEGER,
    location TEXT,
    description TEXT,
    imagesJson TEXT AS List<String> NOT NULL,
    reportedBy TEXT NOT NULL,
    createdAt TEXT,
    userId INTEGER NOT NULL
);

insertViolationDraft:
INSERT INTO ViolationDraft(facilitiesId, facilityJson, employeeName, employeeId, violationDate, violationDateMillis, location, description, imagesJson, reportedBy, createdAt, userId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateViolationDraft:
UPDATE ViolationDraft
SET
    facilitiesId = ?,
    facilityJson = ?,
    employeeName = ?,
    employeeId = ?,
    violationDate = ?,
    violationDateMillis = ?,
    location = ?,
    description = ?,
    imagesJson = ?,
    reportedBy = ?,
    createdAt = ?,
    userId = ?
WHERE id = ?;

getAllViolationDrafts:
SELECT * FROM ViolationDraft;

getViolationDraftsByUserId:
SELECT * FROM ViolationDraft WHERE userId = ? ORDER BY id DESC;

deleteViolationDraft:
DELETE FROM ViolationDraft WHERE id = ?;

CREATE TABLE PermitDraft (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    permitTypeId INTEGER NOT NULL,
    permitTypeJson TEXT,
    projectJson TEXT,
    userJson TEXT,
    permitDateMillis INTEGER,
    startTime TEXT,
    endTime TEXT,
    certificateValidityAnswersJson TEXT,
    generalConditionAnswersJson TEXT,
    generalConditionRemarksJson TEXT,
    signatureUrl TEXT,
    signatureDateMillis INTEGER,
    signatureTime TEXT,
    reportedBy TEXT NOT NULL,
    contractorName TEXT,
    createdAt TEXT,
    userId INTEGER NOT NULL
);

insertPermitDraft:
INSERT INTO PermitDraft(permitTypeId, permitTypeJson, projectJson, userJson, permitDateMillis, startTime, endTime, certificateValidityAnswersJson, generalConditionAnswersJson, generalConditionRemarksJson, signatureUrl, signatureDateMillis, signatureTime, reportedBy, contractorName, createdAt, userId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updatePermitDraft:
UPDATE PermitDraft
SET
    permitTypeId = ?,
    permitTypeJson = ?,
    projectJson = ?,
    userJson = ?,
    permitDateMillis = ?,
    startTime = ?,
    endTime = ?,
    certificateValidityAnswersJson = ?,
    generalConditionAnswersJson = ?,
    generalConditionRemarksJson = ?,
    signatureUrl = ?,
    signatureDateMillis = ?,
    signatureTime = ?,
    reportedBy = ?,
    contractorName = ?,
    createdAt = ?,
    userId = ?
WHERE id = ?;

getAllPermitDrafts:
SELECT * FROM PermitDraft;

getPermitDraftsByUserId:
SELECT * FROM PermitDraft WHERE userId = ? ORDER BY id DESC;

deletePermitDraft:
DELETE FROM PermitDraft WHERE id = ?;

CREATE TABLE LessonLearnedDraft (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    facilitiesId INTEGER,
    projectJson TEXT,
    title TEXT,
    description TEXT,
    reportedBy TEXT,
    imagesJson TEXT,
    createdAt TEXT,
    userId INTEGER NOT NULL
);

insertLessonLearnedDraft:
INSERT OR REPLACE INTO LessonLearnedDraft (
    id,
    facilitiesId,
    projectJson,
    title,
    description,
    reportedBy,
    imagesJson,
    createdAt,
    userId
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

getLessonLearnedDraftsByUserId:
SELECT * FROM LessonLearnedDraft WHERE userId = ? ORDER BY id DESC;

getLessonLearnedDraftById:
SELECT * FROM LessonLearnedDraft WHERE id = ?;

deleteLessonLearnedDraft:
DELETE FROM LessonLearnedDraft WHERE id = ?;
